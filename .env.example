# MA Alerts — Environment Variables
# Copy this file to `.env` (gitignored) and fill in real values for local runs.
# For GitHub Actions, add these as repository secrets (same names).

# --- Twelve Data ---
# Sign up at https://twelvedata.com (free tier sufficient)
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# --- Turso (hosted SQLite) ---
# Get these via Turso CLI:
#   turso db create ma-alerts
#   turso db show ma-alerts --url
#   turso db tokens create ma-alerts
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_token_here

# --- Telegram ---
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your personal chat ID — get by messaging the bot then visiting:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Optional: separate test chat for smoke_test ---
TELEGRAM_TEST_CHAT_ID=your_test_chat_id_here

# --- Optional: separate test DB for smoke_test ---
TURSO_TEST_DATABASE_URL=libsql://your-test-db.turso.io
TURSO_TEST_AUTH_TOKEN=your_test_token_here

# --- Logging ---
LOG_LEVEL=INFO
